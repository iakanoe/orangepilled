{
  "name": "orangepilled",
  "version": "0.1.0",
  "private": true,
  "description": "PWA para registro y visualizacion de accionares viales de una flota vehicular (MVP)",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gen-icons.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test:push": "node scripts/test-push.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "resend": "^4.0.1",
    "standardwebhooks": "^1.0.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "eslint-import-resolver-typescript": "3.6.3",
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    }
  },
  "devDependencies": {
    "@serwist/next": "^9.0.11",
    "@types/leaflet": "^1.9.16",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "serwist": "^9.0.11",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
