# ---- Supabase ----
# From Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key — SERVER ONLY. Never expose to the client.
# Used by API route handlers to send push + fan-out notifications.
SUPABASE_SECRET_KEY=sb_secret_...

# Storage bucket name for report/vehicle photos (create it in Supabase Storage)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=media

# ---- Resend (email / OTP) ----
# Set automatically by the Vercel Resend integration. For local dev copy the
# key from the Resend dashboard (resend.com/api-keys).
RESEND_API_KEY=re_...
# Sender. On the free tier use onboarding@resend.dev (delivers only to your
# own account email) or verify one domain for free and use it here.
EMAIL_FROM=Alerta Patente <onboarding@resend.dev>
# Secret from Supabase > Authentication > Hooks > Send Email hook.
# Format: v1,whsec_...  (paste it verbatim)
SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# ---- Web Push (VAPID) ----
# Generate with:  npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ---- App ----
# App name displayed in the UI, notifications, and metadata
NEXT_PUBLIC_APP_NAME=Alerta Patente
# Public origin, used in push payload links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
