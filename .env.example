# ---- Supabase ----
# From Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the client.
# Used by API route handlers to send push + fan-out notifications.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name for report/vehicle photos (create it in Supabase Storage)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=media

# ---- Web Push (VAPID) ----
# Generate with:  npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ---- App ----
NEXT_PUBLIC_APP_NAME=Alerta Patente
# Public origin, used in push payload links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
